# ==========================================
# SmartRoom Portable API - Docker Environment Config
# ==========================================

# Server Settings
PORT=8787
API_LISTEN_HOST=0.0.0.0
ALLOW_INSECURE_HTTP=true

# App URLs & CORS
APP_BASE_URL=https://tokinsmartroom-495306.web.app
ALLOWED_ORIGINS=https://tokinsmartroom-495306.web.app,http://localhost:3000

# Email & Power Automate Flows
YAGEO_EMAIL_DOMAIN=yageo.com
POWER_AUTOMATE_VERIFICATION_FLOW_URL=https://prod-xx.southeastasia.logic.azure.com/...
POWER_AUTOMATE_USER_LOOKUP_FLOW_URL=https://prod-xx.southeastasia.logic.azure.com/...

# Firebase Settings
FIREBASE_DATABASE_ID=ai-studio-28114784-a066-482c-9738-dfb6c9d68ce0
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
ALLOW_ANONYMOUS_INTERNAL_AUTH=false

# Admin Security
ADMIN_SESSION_SIGNING_SECRET=generate_a_random_32_char_secret_key_here

# Microsoft SQL Server Database
SQL_SERVER=192.168.1.100
SQL_DATABASE=SmartRoomDB
SQL_USER=smartroom_app
SQL_PASSWORD=your_secure_sql_password_here
